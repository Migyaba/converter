# Serveur
PORT=4599
HOST=127.0.0.1
MAX_BODY_MB=200

# Auth / SaaS
# Crée le premier admin au démarrage si aucun admin n'existe
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
BOOTSTRAP_ADMIN_QUOTA=1000

# Inscriptions publiques (1 = ouvertes, 0 = fermées)
REGISTRATION_OPEN=1

# Quota mensuel Free (nouveaux comptes)
FREE_MONTHLY_QUOTA=3
DEFAULT_MONTHLY_QUOTA=3

# Quota Standard
STANDARD_MONTHLY_QUOTA=50

# Quota Pro (inscription via /register?plan=pro — paiement Stripe à venir)
PRO_MONTHLY_QUOTA=500

# Durée de session (jours)
SESSION_DAYS=14

# Cookies Secure (1 en HTTPS / prod)
# COOKIE_SECURE=1
# NODE_ENV=production

# Chemin SQLite (défaut : storage/app.db)
# DB_PATH=./storage/app.db

